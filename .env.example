# Copy this file to .env and fill in your values.
# cp .env.example .env

# --- Telegram (REQUIRED) ---
# Get a bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal chat ID, group ID, or channel ID.
# Easiest way: message @userinfobot on Telegram, it returns your chat ID.
TELEGRAM_CHAT_ID=your_chat_id_here

# --- DeepSeek (OPTIONAL) ---
# Used by alerts/bot_interactive.py for /ask Q&A and news summarization.
# Without this, the interactive bot still runs but /ask and AI features are disabled.
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- DeepSeek model tier overrides (OPTIONAL) ---
# Defaults are sensible; only set these if you want to swap models without code edits.
#   PRO  is used for user-facing Q&A, daily/weekend briefings, post-mortems, recommendations.
#   FAST is used for high-frequency monitors, news/web summarization, structured extraction.
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# DEEPSEEK_MODEL_FAST=deepseek-v4-flash

# --- Anthropic / Claude (OPTIONAL but recommended) ---
# Powers the reasoning tier of the unified LLM layer (alerts/llm): the roundtable,
# daily/weekend briefings, post-mortems, and the interactive Q&A agent. Without it,
# the router falls back to DeepSeek for those paths too (lower quality, still works).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Override the reasoning-tier model if desired (default: claude-opus-4-8).
# LLM_REASONING_MODEL=claude-opus-4-8
